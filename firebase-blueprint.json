{
  "entities": {
    "Admission": {
      "title": "Admission",
      "description": "Student online admission applications submitted by parents/students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "formType": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 50 },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fatherName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "motherName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 20 },
        "class": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "remarks": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentName", "phone"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Feedback, suggestions and queries submitted by parents, students, and visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "formType": { "type": "string", "maxLength": 30 },
        "date": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "class": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "message"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Portal wide configurations (result link, notice popups, gallery images, whatsapp groups, ticker marquee)",
      "type": "object",
      "properties": {
        "data": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "MarksSheet": {
      "title": "MarksSheet",
      "description": "Student examination marks submitted by teachers or admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "class": { "type": "string", "maxLength": 50 },
        "section": { "type": "string", "maxLength": 20 },
        "examType": { "type": "string", "maxLength": 50 },
        "month": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 50 },
        "maxMarks": { "type": "number" },
        "records": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/admissions/{admissionId}": {
      "schema": "Admission",
      "description": "Public admission forms"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Public feedback entries"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Portal wide configurations"
    },
    "/marks_sheets/{sheetId}": {
      "schema": "MarksSheet",
      "description": "School exam marks sheets"
    }
  }
}
